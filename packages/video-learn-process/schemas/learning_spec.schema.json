{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video_id",
    "source_sha256",
    "source_path",
    "status_code",
    "duration_ms",
    "fps",
    "frame_count",
    "model",
    "conclusions",
    "learned_at"
  ],
  "properties": {
    "schema_version": {
      "const": "learning_spec.v2"
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_path": {
      "type": "string",
      "pattern": "^raw/videos/"
    },
    "status_code": {
      "const": "analysis.ok"
    },
    "duration_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation", "frame_index", "pts_ms", "sha256"],
        "properties": {
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "frame_index": {
            "type": "integer",
            "minimum": 0
          },
          "pts_ms": {
            "type": "number",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "learned_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
