{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "model",
    "response_model",
    "request_id",
    "response_id",
    "finish_reason",
    "submitted_frames",
    "ts"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "response_model": {
      "type": ["string", "null"]
    },
    "request_id": {
      "type": ["string", "null"]
    },
    "response_id": {
      "type": "string",
      "minLength": 1
    },
    "finish_reason": {
      "const": "stop"
    },
    "submitted_frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame_index", "pts_ms", "sha256"],
        "properties": {
          "frame_index": {
            "type": "integer",
            "minimum": 0
          },
          "pts_ms": {
            "type": "number",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    }
  }
}
